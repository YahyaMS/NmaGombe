rules_version = '2';

// Unguessable URLs are not security. Everything is namespaced by uid and guarded.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isExec()  { return signedIn() && request.auth.token.role in ['exec','admin']; }

    // CPD certificates uploaded by the member.
    match /cpd/{uid}/{file} {
      allow read: if isSelf(uid) || isExec();
      allow write: if isSelf(uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Dues receipts — generated by a Function, never uploaded by a client.
    match /receipts/{uid}/{file} {
      allow read: if isSelf(uid) || isExec();
      allow write: if false;
    }

    // Public site imagery.
    match /public/{file} {
      allow read: if true;
      allow write: if isExec();
    }

    // Clinical guidelines/forms/circulars — member-only, never served via a
    // Storage download URL (docs/09-DECISIONS.md ADR-022: a getDownloadURL()
    // token bypasses these rules on every request after the first, which
    // this file's own opening line calls out as not security). Admin SDK
    // only, both directions — exec upload goes through
    // /api/admin/documents, member download through
    // /portal/documents/[id]/download, neither ever touches this path via
    // the client SDK.
    match /guidelines/{id}/{file} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
