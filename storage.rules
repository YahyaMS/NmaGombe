rules_version = '2';

// Unguessable URLs are not security. Everything is namespaced by uid and guarded.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isExec()  { return signedIn() && request.auth.token.role in ['exec','admin']; }

    // CPD certificates uploaded by the member.
    match /cpd/{uid}/{file} {
      allow read: if isSelf(uid) || isExec();
      allow write: if isSelf(uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Dues receipts — generated by a Function, never uploaded by a client.
    match /receipts/{uid}/{file} {
      allow read: if isSelf(uid) || isExec();
      allow write: if false;
    }

    // Public site imagery.
    match /public/{file} {
      allow read: if true;
      allow write: if isExec();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
