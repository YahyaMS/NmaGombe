{
  "name": "nma-gombe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/inject-sw-version.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "analyze": "next experimental-analyze",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:routes": "node scripts/check-routes-built.mjs",
    "emulators": "npm --prefix functions run build && firebase emulators:start",
    "test": "jest --testPathIgnorePatterns=tests/rules",
    "test:rules": "jest --testPathPattern=tests/rules --runInBand",
    "test:auth": "jest --testPathPattern=tests/auth",
    "test:smoke": "playwright test tests/smoke",
    "grant-admin": "ts-node scripts/grant-admin.ts"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__traverse": "^7.28.0",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^15.28.1",
    "jest": "^29",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
