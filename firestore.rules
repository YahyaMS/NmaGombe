rules_version = '2';

// NMA Gombe — starter rules. Deny by default; widen narrowly.
// Authorisation reads ONLY from custom claims, never from client-writable documents.
// Cloud Functions using the Admin SDK BYPASS these rules and must check authorisation themselves.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function verified()  { return signedIn() && request.auth.token.verified == true; }
    function isExec()    { return signedIn() && request.auth.token.role in ['exec', 'admin']; }
    function isAdmin()   { return signedIn() && request.auth.token.role == 'admin'; }

    // Fields only a Cloud Function may ever write.
    function noTrustFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'role', 'duesPaidThrough', 'verifiedAt']);
    }
    // Folio number is frozen once verified, to prevent identity swap after approval.
    function folioUnchangedIfVerified() {
      return resource.data.status != 'verified'
        || request.resource.data.folioNumber == resource.data.folioNumber;
    }

    // Full member profile: self or admin only. Never readable by another member.
    match /members/{uid} {
      allow get, list: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'member'
                    && request.resource.data.email == request.auth.token.email
                    && !('duesPaidThrough' in request.resource.data)
                    && !('verifiedAt' in request.resource.data);
      allow update: if (isSelf(uid) && noTrustFieldChanges() && folioUnchangedIfVerified())
                    || (isAdmin() && noTrustFieldChanges());
      allow delete: if false; // deletion is a Function, so payment records stay consistent
    }

    // The only member-queryable collection. Projected from members/* by a Function,
    // through each member's own visibility flags. Hidden fields are ABSENT, not masked.
    match /directoryEntries/{uid} {
      allow get, list: if verified();
      allow write: if false; // Function only
    }

    // No client access at all, in either direction — see docs/09-DECISIONS.md ADR-013.
    // Read only via the Admin SDK from a Server Component. Stated explicitly rather
    // than left to the default-deny catch-all, so a future rules change can't widen
    // it without touching this line.
    match /publicDirectory/{uid} {
      allow read, write: if false;
    }

    match /verificationRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get, list, update: if isAdmin();
      allow delete: if false; // keep the audit trail
    }

    // Rate-limits sendSignInLinkToEmail. Pre-auth (signing in is the point), write-only,
    // never read — the cap is enforced by the rule itself, not by a client-trusted count.
    // One document per email per day; a new day is a new document, so no reset logic needed.
    match /emailLinkAttempts/{email}/days/{date} {
      allow get, list: if false;
      allow create: if request.resource.data.keys().hasOnly(['count', 'lastAttemptAt'])
                    && request.resource.data.count == 1
                    && request.resource.data.lastAttemptAt == request.time;
      allow update: if request.resource.data.keys().hasOnly(['count', 'lastAttemptAt'])
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.count <= 5
                    && request.resource.data.lastAttemptAt == request.time;
      allow delete: if false;
    }

    // Document id is the payment gateway reference => idempotent webhooks.
    match /payments/{ref} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // Function only, after signature verification
    }

    match /duesRates/{year} {
      allow get, list: if signedIn();
      allow write: if false; // Function/admin console only — the client never sets a price
    }

    // Self-reported CPD/CME log. "chapter_event" is reserved for a future
    // event-attendance Function write (Phase 2 registration linking, not
    // built) — a client can only ever write "self_reported", and it's
    // immutable after create so an honest entry can't be relabelled later.
    // creditUnits' upper bound is a sanity/anti-abuse ceiling, not a claimed
    // MDCN figure — we don't know MDCN's actual per-activity or annual point
    // requirements and shouldn't encode a guess as if it were policy.
    //
    // No collection-group view for admin: `allow read: if isAdmin()` below
    // only resolves at a *known* uid (e.g. an admin who already has a
    // member's uid from /admin/members). Querying CPD entries across every
    // member needs its own `match /{path=**}/entries/{id}` collection-group
    // rule plus a collection-group index, and nothing here provides either.
    // Deliberately not built — nothing today needs an aggregate CPD view.
    function cpdEntryShape() {
      return request.resource.data.keys().hasAll(
               ['title', 'provider', 'creditUnits', 'dateAttended', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(
               ['title', 'provider', 'creditUnits', 'dateAttended', 'certificateUrl', 'source', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.provider is string
        && request.resource.data.provider.size() > 0 && request.resource.data.provider.size() <= 160
        && request.resource.data.creditUnits is number
        && request.resource.data.creditUnits > 0 && request.resource.data.creditUnits <= 100
        && request.resource.data.dateAttended is string
        && request.resource.data.dateAttended.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.source == 'self_reported'
        && (!('certificateUrl' in request.resource.data) || request.resource.data.certificateUrl is string);
    }

    match /cpdEntries/{uid}/entries/{id} {
      allow get, list: if isSelf(uid) && verified();
      allow read: if isAdmin();
      allow create: if isSelf(uid) && verified() && cpdEntryShape()
                    && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid) && verified() && cpdEntryShape()
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSelf(uid) && verified();
    }

    match /events/{id} {
      allow get, list: if true;
      allow write: if isExec();
    }

    match /registrations/{id} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if verified() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isExec();
    }

    match /news/{slug} {
      allow get, list: if resource.data.status == 'published' || isExec();
      allow write: if isExec();
    }

    match /jobs/{id} {
      allow get, list: if verified();
      allow create: if verified() && request.resource.data.postedBy == request.auth.uid
                    && request.resource.data.expiresAt > request.time; // expiry is mandatory
      allow update, delete: if isExec()
                    || (signedIn() && resource.data.postedBy == request.auth.uid);
    }

    // Sensitive. Exec only. No clinical or family detail is stored here at all.
    match /welfareCases/{id} {
      allow read, write: if isExec();
    }

    match /broadcasts/{id} {
      allow get, list: if isExec();
      allow write: if false; // Function only, so the log cannot be edited after the fact
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
