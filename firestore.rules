rules_version = '2';

// NMA Gombe — starter rules. Deny by default; widen narrowly.
// Authorisation reads ONLY from custom claims, never from client-writable documents.
// Cloud Functions using the Admin SDK BYPASS these rules and must check authorisation themselves.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function verified()  { return signedIn() && request.auth.token.verified == true; }
    function isExec()    { return signedIn() && request.auth.token.role in ['exec', 'admin']; }
    function isAdmin()   { return signedIn() && request.auth.token.role == 'admin'; }

    // Fields only a Cloud Function may ever write.
    function noTrustFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'role', 'duesPaidThrough', 'verifiedAt']);
    }
    // Folio number is frozen once verified, to prevent identity swap after approval.
    function folioUnchangedIfVerified() {
      return resource.data.status != 'verified'
        || request.resource.data.folioNumber == resource.data.folioNumber;
    }

    // Full member profile: self or admin only. Never readable by another member.
    match /members/{uid} {
      allow get, list: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'member'
                    && request.resource.data.email == request.auth.token.email
                    && !('duesPaidThrough' in request.resource.data)
                    && !('verifiedAt' in request.resource.data);
      allow update: if (isSelf(uid) && noTrustFieldChanges() && folioUnchangedIfVerified())
                    || (isAdmin() && noTrustFieldChanges());
      allow delete: if false; // deletion is a Function, so payment records stay consistent
    }

    // The only member-queryable collection. Projected from members/* by a Function,
    // through each member's own visibility flags. Hidden fields are ABSENT, not masked.
    match /directoryEntries/{uid} {
      allow get, list: if verified();
      allow write: if false; // Function only
    }

    // No client access at all, in either direction — see docs/09-DECISIONS.md ADR-013.
    // Read only via the Admin SDK from a Server Component. Stated explicitly rather
    // than left to the default-deny catch-all, so a future rules change can't widen
    // it without touching this line.
    match /publicDirectory/{uid} {
      allow read, write: if false;
    }

    match /verificationRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get, list, update: if isAdmin();
      allow delete: if false; // keep the audit trail
    }

    // Rate-limits sendSignInLinkToEmail. Pre-auth (signing in is the point), write-only,
    // never read — the cap is enforced by the rule itself, not by a client-trusted count.
    // One document per email per day; a new day is a new document, so no reset logic needed.
    //
    // The cap counts ATTEMPTS, not delivered emails: a member whose link lands in
    // spam spends attempts re-requesting it, and hitting the cap locks them out of
    // signing in until midnight Lagos time. 5 was too tight for that — a real member
    // reached it during the first week of live signups. 10 still stops abuse (Firebase
    // enforces its own per-address quota underneath this) while leaving room for a
    // member to retry a link that never arrived. scripts/reset-email-attempts.ts
    // clears a locked-out address without waiting for the day to roll over.
    match /emailLinkAttempts/{email}/days/{date} {
      allow get, list: if false;
      allow create: if request.resource.data.keys().hasOnly(['count', 'lastAttemptAt'])
                    && request.resource.data.count == 1
                    && request.resource.data.lastAttemptAt == request.time;
      allow update: if request.resource.data.keys().hasOnly(['count', 'lastAttemptAt'])
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.count <= 10
                    && request.resource.data.lastAttemptAt == request.time;
      allow delete: if false;
    }

    // Document id is the payment gateway reference => idempotent webhooks.
    match /payments/{ref} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // Function only, after signature verification
    }

    match /duesRates/{year} {
      allow get, list: if signedIn();
      allow write: if false; // Function/admin console only — the client never sets a price
    }

    // Self-reported CPD/CME log. "chapter_event" entries are written only by
    // markAttendance (functions/src/registrations.ts), via the Admin SDK —
    // a client can only ever create "self_reported", and once a doc's
    // source is "chapter_event" the client cannot update OR delete it at
    // all, not even its own owner (see the `resource.data.source ==
    // 'self_reported'` guard below). Without that, a member could edit an
    // exec-confirmed attendance entry's creditUnits or date after the fact
    // — the same integrity gap source's create-time immutability already
    // closes, just at the wrong point in the lifecycle if update/delete
    // aren't gated on it too. creditUnits' upper bound is a sanity/anti-abuse
    // ceiling, not a claimed MDCN figure — we don't know MDCN's actual
    // per-activity or annual point requirements and shouldn't encode a guess
    // as if it were policy.
    //
    // No collection-group view for admin: `allow read: if isAdmin()` below
    // only resolves at a *known* uid (e.g. an admin who already has a
    // member's uid from /admin/members). Querying CPD entries across every
    // member needs its own `match /{path=**}/entries/{id}` collection-group
    // rule plus a collection-group index, and nothing here provides either.
    // Deliberately not built — nothing today needs an aggregate CPD view.
    function cpdEntryShape() {
      return request.resource.data.keys().hasAll(
               ['title', 'provider', 'creditUnits', 'dateAttended', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(
               ['title', 'provider', 'creditUnits', 'dateAttended', 'certificateUrl', 'source', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.provider is string
        && request.resource.data.provider.size() > 0 && request.resource.data.provider.size() <= 160
        && request.resource.data.creditUnits is number
        && request.resource.data.creditUnits > 0 && request.resource.data.creditUnits <= 100
        && request.resource.data.dateAttended is string
        && request.resource.data.dateAttended.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.source == 'self_reported'
        && (!('certificateUrl' in request.resource.data) || request.resource.data.certificateUrl is string);
    }

    match /cpdEntries/{uid}/entries/{id} {
      allow get, list: if isSelf(uid) && verified();
      allow read: if isAdmin();
      allow create: if isSelf(uid) && verified() && cpdEntryShape()
                    && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid) && verified() && resource.data.source == 'self_reported'
                    && cpdEntryShape()
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSelf(uid) && verified() && resource.data.source == 'self_reported';
    }

    // cpdCreditUnits' bound mirrors cpdEntries.creditUnits' own — an exec
    // mistyping 500 instead of 5 shouldn't be storable. Optional: absent
    // means this event earns no CPD credit (e.g. a social event).
    function eventShapeValid() {
      return !('cpdCreditUnits' in request.resource.data)
        || (request.resource.data.cpdCreditUnits is number
            && request.resource.data.cpdCreditUnits > 0
            && request.resource.data.cpdCreditUnits <= 100);
    }

    match /events/{id} {
      allow get, list: if true;
      allow write: if isExec() && eventShapeValid();
    }

    // Clinical guideline/form/circular metadata — member-only, read-only for
    // every client. Written only via the Admin SDK (Route Handler
    // /api/admin/documents, same conversion as news/events), so this is
    // deliberately allow write: if false, not isExec() — no client-rules
    // backdoor for a collection with no client write path at all. The file
    // itself lives in Storage under guidelines/{id}/{file}, which is
    // Admin-SDK-only too (storage.rules) — see docs/09-DECISIONS.md ADR-022
    // for why a member-only file is never served via getDownloadURL().
    match /documents/{id} {
      allow get, list: if verified();
      allow write: if false;
    }

    // Association-supplied name register — an admin's fuzzy name-matching
    // aid during /admin/verification (docs/09-DECISIONS.md ADR-024), never
    // read by any client, exec or admin included: no consent basis to
    // expose ~300 real names to a browser, even an admin's. Written only by
    // scripts/import-register.ts (Admin SDK, run by hand), read only by
    // lib/data/registerMatch.ts (also Admin SDK, server-only).
    match /registerEntries/{id} {
      allow read, write: if false;
    }

    // Registration id is deterministic ({eventId}_{uid} — see
    // docs/03-DATA-MODEL.md), so double-registration is a rules-level no-op.
    // A member creates their own registration directly (not privileged, no
    // Function needed — same reasoning as creating their own members/{uid}
    // doc at signup). Every attendance field is Function-only:
    // `allow update: if false` entirely, not a trust-field carve-out on an
    // otherwise-open rule — a raw client update that set attended:true
    // without going through markAttendance would leave attendance recorded
    // with no linked CPD entry ever created, an inconsistent state, not
    // just a bypassed check. markAttendance/unmarkAttendance
    // (functions/src/registrations.ts) write both documents in the same
    // transaction.
    match /registrations/{id} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if verified() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.eventId is string
                    && request.resource.data.attended == false
                    && request.resource.data.keys().hasOnly(['uid', 'eventId', 'attended']);
      allow update: if false;
      allow delete: if isExec();
    }

    match /news/{slug} {
      allow get, list: if resource.data.status == 'published' || isExec();
      allow write: if isExec();
    }

    // Compulsory expiry: 60 days is the hard cap regardless of type — a
    // locum gap is days to weeks, not a season (docs/06-ROADMAP.md: "a board
    // full of dead listings is worse than no board"). lib/data/schemas.ts's
    // JOB_MAX_EXPIRY_DAYS mirrors this so the create form rejects an
    // out-of-range date before the write is even attempted, not just show a
    // rules-denied error after the fact.
    function jobShapeValid() {
      return request.resource.data.keys().hasAll(
               ['title', 'facility', 'town', 'type', 'description', 'contactVia', 'postedBy', 'expiresAt', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(
               ['title', 'facility', 'town', 'type', 'description', 'contactVia', 'postedBy', 'expiresAt', 'status', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.facility is string
        && request.resource.data.facility.size() > 0 && request.resource.data.facility.size() <= 160
        && request.resource.data.town is string
        && request.resource.data.town.size() > 0 && request.resource.data.town.size() <= 120
        && request.resource.data.type in ['locum', 'permanent', 'nysc']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 4000
        && request.resource.data.contactVia is string
        && request.resource.data.contactVia.size() > 0 && request.resource.data.contactVia.size() <= 40
        && request.resource.data.status in ['active', 'filled'];
    }

    // A member's entire write surface on welfareCases: exactly this shape,
    // nothing else. No amount (absent, not zero — see docs/03-DATA-MODEL.md),
    // no status other than "open", no requester but themselves.
    function welfareCaseCreateValid() {
      return request.resource.data.keys().hasOnly(['requester', 'status', 'createdAt'])
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    match /jobs/{id} {
      allow get, list: if verified();
      allow create: if verified()
                    && request.resource.data.postedBy == request.auth.uid
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(60, 'd')
                    && request.resource.data.createdAt == request.time
                    && jobShapeValid();
      // Content can be corrected, but postedBy, expiresAt and createdAt are
      // frozen — reposting is the honest way to extend a listing (a fresh
      // 60-day cap, not a silently renewed one) or to bump it back to the
      // top of a newest-first list, and postedBy can never be reassigned.
      // Moderation is delete-only (below), not update — exec removes what
      // shouldn't be on the platform rather than silently editing a
      // member's own content.
      allow update: if verified()
                    && resource.data.postedBy == request.auth.uid
                    && request.resource.data.postedBy == resource.data.postedBy
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.createdAt == resource.data.createdAt
                    && jobShapeValid();
      // This is the first member-generated, unmoderated content in the app
      // (every other write is exec-authored or self-scoped) — exec/admin
      // can remove a listing that shouldn't be here; the poster can also
      // remove their own.
      allow delete: if isExec() || (signedIn() && resource.data.postedBy == request.auth.uid);
    }

    // Sensitive. No clinical or family detail is stored here at all.
    // A verified member may open their own case — create only, exactly the
    // shape welfareCaseCreateValid() allows — but can never read, update or
    // delete it back, their own case included; see docs/03-DATA-MODEL.md for
    // why that's a rules fact, not just a UI omission ("form only, not a
    // case viewer"). Everything else is exec-only, direct client read/write,
    // no Function layer — a deliberate asymmetry from this file's usual
    // trust-field-goes-through-a-Function pattern, because there is no trust
    // field here a member could otherwise smuggle: their entire write
    // surface is "create exactly one shape," not "update anything."
    match /welfareCases/{id} {
      allow read, update, delete: if isExec();
      allow create: if isExec() || (verified() && welfareCaseCreateValid());
    }

    match /broadcasts/{id} {
      allow get, list: if isExec();
      allow write: if false; // Function only, so the log cannot be edited after the fact
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
