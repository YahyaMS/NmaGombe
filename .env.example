# ── Firebase (client) ─────────────────────────────────────────────────────────
# Safe to expose; they identify the project, they do not authorise anything.
# Access control lives in firestore.rules + App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA site key — public)
NEXT_PUBLIC_APPCHECK_SITE_KEY=

# ── Firebase (server) ─────────────────────────────────────────────────────────
# Service account JSON, base64-encoded. NEVER commit. NEVER paste into WhatsApp.
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Paystack ──────────────────────────────────────────────────────────────────
# Test keys locally. Live keys exist ONLY in the hosting provider's secret store.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_SECRETARIAT=234XXXXXXXXXX   # international format, no + and no spaces
NEXT_PUBLIC_MDCN_PORTAL_URL=                     # the real MDCN renewal portal URL, once known

# ── Local development ─────────────────────────────────────────────────────────
# Point at the emulators. Never point local development at the production project.
NEXT_PUBLIC_USE_EMULATORS=true
